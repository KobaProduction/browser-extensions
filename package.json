{
  "name": "@kobaproduction/browser-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun test && bun run validate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "validate": "bun scripts/validate.ts",
    "build": "bun scripts/build.ts --module all",
    "build:vk": "bun scripts/build.ts --module vk-archive",
    "build:changed": "bun scripts/build.ts --module changed",
    "release:plan": "bun scripts/release-plan.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/chrome": "^0.1.3",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0"
  }
}
