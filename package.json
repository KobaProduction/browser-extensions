{
  "name": "@kobaproduction/browser-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*",
    "modules/chatgpt-booster/packages/*"
  ],
  "scripts": {
    "check": "bun scripts/check-affected.ts",
    "check:plan": "bun scripts/check-affected.ts --plan",
    "check:all": "bun scripts/check-affected.ts --all",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p packages/shell/tsconfig.json && vue-tsc --noEmit -p modules/vk-booster/tsconfig.json && vue-tsc --noEmit -p packages/widgets/tsconfig.json && tsc --noEmit -p tsconfig.vk-tests.json && vue-tsc --noEmit -p modules/chatgpt-booster/packages/ui/tsconfig.json",
    "test": "bun scripts/test-affected.ts",
    "test:plan": "bun scripts/test-affected.ts --plan",
    "test:all": "bun scripts/test-affected.ts --all",
    "validate": "bun scripts/validate.ts",
    "build": "bun scripts/build.ts --module all",
    "build:vk": "bun scripts/build.ts --module vk-booster",
    "build:changed": "bun scripts/build.ts --module changed",
    "release:plan": "bun scripts/release-plan.ts",
    "check:chatgpt": "bun run typecheck && bun run test:chatgpt",
    "test:chatgpt": "bun test ./modules/chatgpt-booster/tests/ ./modules/chatgpt-booster/packages/",
    "build:chatgpt": "bun scripts/build.ts --module chatgpt-booster",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "build:shared": "bun scripts/build.ts --module packages",
    "ui:lab": "bun run --cwd apps/ui-lab dev",
    "ui:lab:build": "bun run --cwd apps/ui-lab build",
    "ui:lab:test": "bun run --cwd apps/ui-lab test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bun": "^1.3.0",
    "@types/chrome": "^0.1.3",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "clsx": "^2.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "lucide-vue-next": "^0.545.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue": "^3.5.22",
    "vue-tsc": "^3.0.7"
  }
}
