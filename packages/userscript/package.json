    "build:dev": "CHATGPT_BOOSTER_VARIANT=dev vite build"
  },
  "dependencies": {
    "@chatgpt-booster/core": "workspace:*",
    "@chatgpt-booster/ui": "workspace:*",
    "vue": "^3.5.22",
    "@chatgpt-booster/features": "workspace:*",
    "@chatgpt-booster/observer": "workspace:*",
    "@chatgpt-booster/telemetry": "workspace:*"
  }
}
