{
  "name": "chatgpt-booster",
  "version": "0.8.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint",
    "typecheck": "bun run --filter '@chatgpt-booster/*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run --filter @chatgpt-booster/extension build && bun run --filter @chatgpt-booster/userscript build",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/chrome": "^0.1.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vite-plugin-web-extension": "^4.5.1",
    "vue": "^3.5.22",
    "vue-tsc": "^3.0.7",
    "@tailwindcss/vite": "^4.1.14",
    "tailwindcss": "^4.1.14"
  }
}
