{
  "name": "@chatgpt-booster/userscript",
  "version": "2.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ../../../../scripts/build.ts --module chatgpt-booster --target=userscript",
    "dev": "bun ../../../../scripts/build.ts --module chatgpt-booster --target=userscript --channel=dev --build-number=1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:prod": "bun ../../../../scripts/build.ts --module chatgpt-booster --target=userscript --channel=prod",
    "build:dev": "bun ../../../../scripts/build.ts --module chatgpt-booster --target=userscript --channel=dev --build-number=1"
  },
  "dependencies": {
    "@chatgpt-booster/core": "workspace:*",
    "@chatgpt-booster/ui": "workspace:*",
    "vue": "^3.5.22",
    "@chatgpt-booster/features": "workspace:*",
    "@chatgpt-booster/observer": "workspace:*",
    "@chatgpt-booster/telemetry": "workspace:*",
    "@kobaproduction/browser-core": "workspace:*"
  }
}
